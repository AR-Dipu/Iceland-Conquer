extends SceneTree
const Collection = preload("res://scripts/character_collection.gd")

func _initialize() -> void:
	run.call_deferred()

func run() -> void:
	var path := "user://collection_test_" + Crypto.new().generate_random_bytes(8).hex_encode()
	var wallet := PracticeWallet.new()
	assert(wallet.open(path + ".json"))
	assert(wallet.transact("fixture", 150-wallet.balance))
	var collection := Collection.new()
	collection.open(wallet,path + ".equip")
	assert(collection.equipped == "cat" and not collection.equip("hare"))
	assert(not collection.buy("otter") and wallet.balance == 150)
	assert(collection.buy("hare") and wallet.balance == 0 and collection.buy("hare"))
	assert(wallet.balance == 0 and collection.equip("hare"))
	var reload := PracticeWallet.new()
	assert(reload.open(path + ".json") and reload.balance == 0)
	collection.open(reload,path + ".equip")
	assert(collection.owns("hare") and collection.equipped == "hare")
	collection.open(reload,path.path_join("missing/equip"))
	assert(collection.equipped == "cat" and not collection.equip("hare"))
	assert(reload.transact("fixture-more", 300))
	var wallet_path := reload.path
	reload.path = path.path_join("missing/wallet")
	assert(not collection.buy("turtle") and not collection.owns("turtle") and reload.balance == 300)
	reload.path = wallet_path
	var config: GameConfig = load("res://resources/default_config.tres").duplicate(true)
	config.spawn_points = [Vector2.ZERO,Vector2(20,20)]
	config.cat_indices = [0,1]
	var actor := ConquerCharacter.new()
	actor.setup(0, config)
	actor.apply_character("hare")
	assert(is_equal_approx(actor.movement_speed(),config.player_speed*0.95))
	assert(is_equal_approx(actor.movement_acceleration(),config.player_acceleration*1.15))
	actor.apply_character("otter")
	assert(is_equal_approx(actor.movement_speed(),config.player_speed*1.08))
	assert(is_equal_approx(actor.movement_acceleration(),config.player_acceleration*0.85))
	actor.apply_character("turtle")
	assert(is_equal_approx(actor.movement_speed(),config.player_speed*0.92))
	assert(actor.revival_shield_bonus == 1.0)
	actor.trail.free()
	actor.free()
	var trail := ConquerTrail.new()
	var owned := [PackedVector2Array([Vector2.ZERO,Vector2(100,0),Vector2(100,100),Vector2(0,100)])]
	trail.points = PackedVector2Array([Vector2(100,20),Vector2(180,20)])
	assert(not trail.prepare_capture(owned).is_empty())
	trail.append_point(Vector2(180,80))
	trail.prepare_capture(owned)
	trail.append_point(Vector2(100,80))
	var prepared := trail.prepare_capture(owned,true)
	assert(not prepared.is_empty())
	assert(CaptureTopology.enclosed_prepared(prepared) == CaptureTopology.enclosed(owned,trail.points))
	assert(trail.prepare_capture([],true).is_empty())
	trail.free()
	var game = load("res://scenes/main.tscn").instantiate()
	game.profile_path = path + "_game/"
	assert(DirAccess.make_dir_recursive_absolute(game.profile_path) == OK)
	root.add_child(game)
	game.set_physics_process(false)
	assert(game.wallet.transact("character-fixture", 800))
	game.selector.open_shop()
	assert(game.selector.shop.visible)
	game.selector._shop_action("hare")
	assert(game.collection.owns("hare"))
	game.selector._shop_action("hare")
	assert(game.collection.equipped == "hare")
	game.selector.shop.hide()
	game.start_round()
	assert(game.actors[0].speed_multiplier == 0.95)
	assert(game.collection.buy("turtle") and game.collection.equip("turtle"))
	game.start_round()
	assert(game.match_character == "hare" and game.actors[0].speed_multiplier == 0.95)
	game.choose_country()
	game.start_round()
	assert(game.match_character == "turtle")
	game._set_state(game.State.DEFEATED)
	game._revive_player()
	assert(game.actors[0].protection == game.wallet.settings.shield_seconds + 1.0)
	game.queue_free()
	await process_frame
	print("RESULT character prices, ownership, equipment persistence and passive modifiers passed")
	quit()
